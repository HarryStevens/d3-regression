{
  "name": "d3-regression",
  "version": "2.0.1",
  "description": "Calculate statistical regressions for two-dimensional data",
  "homepage": "https://github.com/HarryStevens/d3-regression#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HarryStevens/d3-regression.git"
  },
  "keywords": [
    "d3",
    "d3-module",
    "statistics",
    "regressions"
  ],
  "license": "BSD-3-Clause",
  "author": {
    "name": "Harry Stevens",
    "url": "http://harryjstevens.com/"
  },
  "type": "module",
  "files": [
    "dist/**/*.js",
    "src/**/*.js",
    "src/**/*.d.ts"
  ],
  "main": "src/index.js",
  "module": "src/index.js",
  "types": "src/index.d.ts",
  "jsdelivr": "dist/d3-regression.min.js",
  "unpkg": "dist/d3-regression.min.js",
  "exports": {
    "types": "./src/index.d.ts",
    "umd": "./dist/d3-regression.min.js",
    "default": "./src/index.js"
  },
  "sideEffects": false,
  "bugs": {
    "url": "https://github.com/HarryStevens/d3-regression/issues"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "eslint": "^8.57.1",
    "mocha": "^11.7.6",
    "rollup": "^4.62.2",
    "typescript": "5"
  },
  "scripts": {
    "test": "mocha 'test/**/*-test.js' && eslint src test rollup.config.js && tsc --noEmit",
    "prepublishOnly": "rm -rf dist && npm test && rollup -c"
  },
  "engines": {
    "node": ">=12"
  },
  "overrides": {
    "brace-expansion": "1.1.15",
    "diff": "8.0.4",
    "serialize-javascript": "7.0.7"
  }
}
